# ============================================
# API Configuration
# ============================================

# Base URL for the backend API
# - Local development: http://localhost:8000/api
# - Network access: http://192.168.1.100:8000/api (replace with your local IP)
# - Production: https://your-domain.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# WebSocket URL for real-time features
# - Local development: ws://localhost:8000
# - Network access: ws://192.168.1.100:8000 (replace with your local IP)
# - Production: wss://your-domain.com (use wss:// for secure WebSocket)
NEXT_PUBLIC_API_BASE_URL_WS=ws://localhost:8000

# ============================================
# Authentication
# ============================================

# NextAuth.js secret key for encrypting sessions
# Generate a secure key using:
# - Terminal: openssl rand -base64 32
# - Or: https://generate-secret.vercel.app/32
# - IMPORTANT: Use a different key for production!
NEXTAUTH_SECRET=your-super-secret-key-here-generate-with-openssl-rand-base64-32

# ============================================
# Optional: Additional Configuration
# ============================================

# Example: Database URL (if needed)
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Example: Redis URL (if needed)
# REDIS_URL=redis://localhost:6379